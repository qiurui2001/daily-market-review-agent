# ── 美股复盘 Agent 环境变量模板 ──
# 复制为 .env 并填入自己的配置

# ── DeepSeek（OpenAI 兼容） ──
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=16384

# ── 邮件交付（QQ 邮箱示例，SMTP_PASS 为授权码而非登录密码） ──
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your@qq.com
SMTP_PASS=你的SMTP授权码
FROM_EMAIL=your@qq.com
REPORT_TO_EMAIL=client@example.com

# ── Agent 行为 ──
AGENT_VERBOSE=true
CREWAI_TRACING_ENABLED=false
HTTP_TIMEOUT=20
# 空响应自动重试：次数与每次退避基数（秒）
LLM_EMPTY_RETRY=3
LLM_RETRY_DELAY=2
# 行业/ETF 板块接口进程内缓存（秒），防限流
SECTOR_CACHE_TTL=600
# 新浪美股日K线进程内缓存（秒）
SINA_KLINE_TTL=1800
# 预测确定性核验口径（变更只对未来生效，勿回改历史）
PRED_VOL_MULT=1.0        # 方向噪音带 = 该值 × 日波动 × √N，带内记为「未定」不计分
PRED_SHOCK_MULT=2.5      # 单日 |涨跌| > 该值 × 日波动 → 记为「冲击日」
PRED_VOL_LOOKBACK=20     # 日波动估计窗口（交易日）
PRED_MIN_LEVEL=100       # 参与判分的最低点位数（过滤噪音）
PRED_MAX_LEVEL=100000     # 参与判分的最高点位数
# 市场体制标签阈值（用于 Track Record 按体制分桶）
REGIME_TREND_GAP=0.8     # MA10/MA30 偏离(%)，超过记为趋势，否则震荡
REGIME_VOL_LOW=0.8       # 日波动(%)低于该值 → 低波动
REGIME_VOL_HIGH=1.5      # 日波动(%)高于该值 → 高波动
# 只追加、哈希链预测台账（防篡改；建议纳入版本控制）
LEDGER_FILE=prediction_ledger.jsonl

# ── 加密货币(BTC/ETH)复盘模块（python crypto_main.py） ──
# 只追加、哈希链的加密预测台账（防篡改；建议纳入版本控制）
CRYPTO_LEDGER_FILE=crypto_ledger.jsonl
# 加密行情/接口进程内缓存（秒），防限流
CRYPTO_KLINE_TTL=600
CRYPTO_JSON_TTL=120
# 加密点位数判分范围（BTC 可达 6 位数、部分币 0.xxx），过滤噪音数字
CRYPTO_PRED_MIN_LEVEL=0.1
CRYPTO_PRED_MAX_LEVEL=10000000

# ── 可选：Telegram 推送（Star → Telegram → 用户） ──
# 免费频道：bot 设为频道管理员，TELEGRAM_CHANNEL_ID 填频道 -100… ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_URL=

# ── 可选：X/Twitter 分发（OAuth 1.0a 用户上下文，用于发每日预告） ──
# 在 X Developer Portal 建 App → Keys and tokens 生成以下四项
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── 模拟交易（美股，10 万美元模拟盘，收盘价成交） ──
PAPER_INITIAL_CASH=100000
PAPER_DIR=paper

REPORT_DIR=reports
OUTPUT_DIR=outputs
